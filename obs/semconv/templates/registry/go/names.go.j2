{#- The Go names of the justabill registry. The output must stay gofmt-clean (obs/semconv's test
    checks it), so every const is its own declaration and nothing needs aligning. -#}
{%- macro str(s) %}"{{ s | trim | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", " ") }}"{% endmacro -%}
{%- macro ident(name) %}{% for part in name[10:] | split(".") %}{{ part | pascal_case | acronym }}{% endfor %}{% endmacro -%}
{%- macro attrs(list) %}{% for a in list | sort(attribute="name") %}{{ "\n//   - " ~ a.name ~ " (" ~ a.requirement_level ~ ")" }}{% endfor %}{% endmacro -%}
{%- macro doc(item) %}{{ "//\n// " ~ (item.brief | trim | replace("\n", "\n// ")) }}{% if item.note %}{{ "\n//\n// " ~ (item.note | trim | replace("\n", "\n// ")) }}{% endif %}{% endmacro -%}
// Code generated by weaver from obs/semconv/registry; DO NOT EDIT.

// Package semconv holds the names of Just a Bill's own telemetry: every justabill.* attribute,
// metric and event, generated from the registry in obs/semconv/registry by `task semconv`.
// Upstream names (http.*, server.*, gen_ai.*) come from go.opentelemetry.io/otel/semconv.
// web/src/lib/obs/names.ts holds the same names for TypeScript.
package semconv

import "go.opentelemetry.io/otel/attribute"
{% for a in ctx.attributes %}

// {{ ident(a.name) }}Key is the attribute {{ a.name }}.
{{ doc(a) }}
//
// Type: {% if a.type is mapping %}enum{% else %}{{ a.type }}{% endif %}. Stability: {{ a.stability }}.
const {{ ident(a.name) }}Key = attribute.Key({{ str(a.name) }})
{% if a.type is mapping %}
{% for m in a.type.members %}

// {{ ident(a.name) }}{{ m.id | pascal_case | acronym }} is the {{ a.name }} value "{{ m.value }}".
{{ doc(m) }}
const {{ ident(a.name) }}{{ m.id | pascal_case | acronym }} = {{ str(m.value) }}
{% endfor %}
{% endif %}
{% endfor %}
{% for m in ctx.metrics %}

// {{ ident(m.metric_name) }}Name is the metric {{ m.metric_name }}.
{{ doc(m) }}
//
// Instrument: {{ m.instrument }}. Unit: {{ m.unit }}. Stability: {{ m.stability }}.
//
// Attributes:{{ attrs(m.attributes) }}
const {{ ident(m.metric_name) }}Name = {{ str(m.metric_name) }}

// {{ ident(m.metric_name) }}Unit is the UCUM unit of {{ m.metric_name }}.
const {{ ident(m.metric_name) }}Unit = {{ str(m.unit) }}

// {{ ident(m.metric_name) }}Description is the description of {{ m.metric_name }}.
const {{ ident(m.metric_name) }}Description = {{ str(m.brief) }}
{% endfor %}
{% for e in ctx.events %}

// {{ ident(e.name) }}Event is the event name {{ e.name }}.
{{ doc(e) }}
//
// Stability: {{ e.stability }}.
//
// Attributes:{{ attrs(e.attributes) }}
const {{ ident(e.name) }}Event = {{ str(e.name) }}
{% endfor %}
