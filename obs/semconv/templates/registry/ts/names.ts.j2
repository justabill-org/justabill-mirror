{#- The TypeScript names of the justabill registry, named like @opentelemetry/semantic-conventions
    (ATTR_*, *_VALUE_*, METRIC_*, EVENT_*) without the justabill prefix. -#}
{%- macro str(s) %}"{{ s | trim | replace("\\", "\\\\") | replace('"', '\\"') | replace("\n", " ") }}"{% endmacro -%}
{%- macro ident(name) %}{{ name[10:] | screaming_snake_case }}{% endmacro -%}
{%- macro attrs(list) %}{% for a in list | sort(attribute="name") %}{{ "\n *   - " ~ a.name ~ " (" ~ a.requirement_level ~ ")" }}{% endfor %}{% endmacro -%}
{%- macro doc(item) %}{{ " * " ~ (item.brief | trim | replace("\n", "\n * ")) }}{% if item.note %}{{ "\n *\n * " ~ (item.note | trim | replace("\n", "\n * ")) }}{% endif %}{% endmacro -%}
// Code generated by weaver from obs/semconv/registry; DO NOT EDIT.
//
// The names of Just a Bill's own telemetry: every justabill.* attribute, metric and event,
// generated from the registry in obs/semconv/registry by `task semconv`. Upstream names (http.*,
// server.*, gen_ai.*) come from @opentelemetry/semantic-conventions. obs/semconv/names.go holds
// the same names for Go.
{% for a in ctx.attributes %}

/**
 * The attribute {{ a.name }}.
 *
{{ doc(a) }}
 *
 * Type: {% if a.type is mapping %}enum{% else %}{{ a.type }}{% endif %}. Stability: {{ a.stability }}.
 */
export const ATTR_{{ ident(a.name) }} = {{ str(a.name) }};
{% if a.type is mapping %}
{% for m in a.type.members %}

/**
 * The {{ a.name }} value "{{ m.value }}".
 *
{{ doc(m) }}
 */
export const {{ ident(a.name) }}_VALUE_{{ m.id | screaming_snake_case }} = {{ str(m.value) }};
{% endfor %}
{% endif %}
{% endfor %}
{% for m in ctx.metrics %}

/**
 * The metric {{ m.metric_name }}.
 *
{{ doc(m) }}
 *
 * Instrument: {{ m.instrument }}. Unit: {{ m.unit }}. Stability: {{ m.stability }}.
 *
 * Attributes:{{ attrs(m.attributes) }}
 */
export const METRIC_{{ ident(m.metric_name) }} = {{ str(m.metric_name) }};

/** The UCUM unit of {{ m.metric_name }}. */
export const METRIC_{{ ident(m.metric_name) }}_UNIT = {{ str(m.unit) }};

/** The description of {{ m.metric_name }}. */
export const METRIC_{{ ident(m.metric_name) }}_DESCRIPTION = {{ str(m.brief) }};
{% endfor %}
{% for e in ctx.events %}

/**
 * The event name {{ e.name }}.
 *
{{ doc(e) }}
 *
 * Stability: {{ e.stability }}.
 *
 * Attributes:{{ attrs(e.attributes) }}
 */
export const EVENT_{{ ident(e.name) }} = {{ str(e.name) }};
{% endfor %}
