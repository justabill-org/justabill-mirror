# Secrets can come from a file instead: for a secret X, X_FILE names a file holding it (production
# mounts them from Secret Manager). Setting both is a startup error. That's CONGRESS_API_KEY,
# GOVINFO_API_KEY, WEB_REVALIDATE_SECRET, REDIS_URL, API_SERVER_KEYS, VERCEL_DRAIN_SECRET and
# VERCEL_WEBHOOK_SECRET (wiki Dev-API, "Secrets from files").

# Congress API key (get from https://api.data.gov/signup/)
CONGRESS_API_KEY=

# GovInfo API key (same api.data.gov key works)
GOVINFO_API_KEY=

# Pipeline request budgets (defaults shown; docs/design/67-upstream-quota-retries.md). Every
# Congress.gov and GovInfo request, retries included, waits on its API's budget. The defaults stay
# under the documented 5,000 requests an hour; production sets PIPELINE_CONGRESS_RPS to 90% of its
# key's X-RateLimit-Limit / 3600. Local runs on the shared dev key can use PIPELINE_CONGRESS_RPS=3.
# PIPELINE_CONGRESS_RPS=1.2
# PIPELINE_CONGRESS_BURST=5
# PIPELINE_GOVINFO_RPS=1.0
# Pause a budget for 5 minutes when less than this percent of the hourly quota is left.
# PIPELINE_QUOTA_RESERVE_PCT=5
# true: Congress.gov and GovInfo share one budget, for a key api.data.gov counts across both.
# PIPELINE_SHARED_KEY_BUDGET=false
# The Federal Register API (no key), for the rules CRA resolutions disapprove (design 590).
# PIPELINE_FEDREG_RPS=1.0
# false: serve leaves out its sync-cra-rules job (every 6 hours), which looks those rules up.
# PIPELINE_CRA_RULES=true
# GCS bucket that keeps a gzipped copy of every 2xx upstream response (production's load; #364).
# Unset locally: nothing is archived.
# UPSTREAM_ARCHIVE_BUCKET=

# Spanner
SPANNER_EMULATOR_HOST=localhost:9010
SPANNER_PROJECT=justabill-local
SPANNER_INSTANCE=test-instance
SPANNER_DATABASE=justabill
# API only: the Spanner database role its sessions assume (#609). Production sets api, whose grants
# allow writes only to users, user_votes and user_favorites. Unset, no role: the service account's
# IAM roles apply. The emulator accepts a role without enforcing it. Runbook:
# docs/runbooks/api-database-role.md.
# SPANNER_DATABASE_ROLE=api

# Redis (optional — cache disabled if unavailable). The pipeline reads it too: after each sync
# step it deletes the API's cached copies (bills:detail:<id>) of the bills it stored, before the
# web revalidation below (#400). Unset, the pipeline leaves Redis alone. Both the API and the
# pipeline also take REDIS_URL_FILE (production mounts the password-bearing URL as a file).
# Unset, the API uses redis://localhost:6379; set but empty (REDIS_URL=), it runs without a cache.
REDIS_URL=redis://localhost:6379

# Pipeline serve: address of the health server (/healthz liveness, /readyz readiness, /status).
# No Service or Ingress exposes it; kubelet probes it and operators use kubectl port-forward.
# PIPELINE_HEALTH_ADDR=:8081
# Pipeline serve: override a job's run timeout (a Go duration shorter than the job's interval).
# The name is the job's, uppercased with _ for -: SYNC_BILLS, SYNC_MEMBERS, SYNC_VOTES, SYNC_TEXTS,
# SYNC_SUMMARIES, SYNC_GOVINFO, SYNC_GAO, SYNC_CRA_RULES. serve refuses to start on a bad value or an
# unknown job name.
# PIPELINE_JOB_TIMEOUT_SYNC_BILLS=3h30m
# Pipeline serve and backfill: after each bills, votes, summaries or govinfo run, POST the bills
# it stored to the web app's /api/revalidate so their pages refresh (#297). Off unless both the
# URL and a secret (one of REVALIDATE_SECRETS) are set; the secret may come from a file instead.
# WEB_REVALIDATE_URL=http://localhost:3000/api/revalidate
# WEB_REVALIDATE_SECRET=
# WEB_REVALIDATE_SECRET_FILE=

# Vertex AI bill summaries (optional: no GCP_PROJECT, no summaries). Uses Application Default
# Credentials. Gemini 3 models are served from global, us and eu, not us-central1.
GCP_PROJECT=
GCP_LOCATION=global
# Pinned model and generation limits (defaults shown; docs/design/68-ai-summaries-gemini-3.md).
# AI_MODEL=gemini-3.8-flash
# AI_THINKING_LEVEL=LOW
# AI_MAX_OUTPUT_TOKENS=8192
# AI_MAX_INPUT_TOKENS=400000
# standard, or flex (Flex PayGo: half price, Preview terms, global only)
# AI_REQUEST_TYPE=standard
# Give the model the bill's latest CRS summary as labeled context (prompt bill-v3), and summarize a
# bill again once when a new CRS summary arrives. false leaves both out without churning summaries.
# AI_CRS_CONTEXT=true
# Give the model the rule a CRA resolution disapproves (its Federal Register abstract, from
# sync-cra-rules; prompt bill-v4), and summarize the resolution again once when that rule data
# changes. false leaves both out without churning summaries.
# AI_RULE_CONTEXT=true
# Summary job (pipeline serve; defaults shown). Each run takes up to min(AI_SUMMARY_BATCH,
# AI_DAILY_REQUEST_CAP - bills attempted today in UTC) bills from the queue: voted bills first, then
# bills with a status date in the last AI_RECENT_DAYS days. A run's timeout is 5/6 of the interval.
# AI_SUMMARY_INTERVAL=30m
# AI_SUMMARY_BATCH=200
# AI_WORKERS=8
# AI_DAILY_REQUEST_CAP=3000
# AI_RECENT_DAYS=30
# Re-summarize bills whose summary came from an older prompt version, after every other due bill.
# AI_RESUMMARIZE_ON_PROMPT_CHANGE=false
# Diff summaries (what changed between text versions). Off: their attempts aren't recorded yet.
# AI_DIFF_SUMMARIES_ENABLED=false
# Law-change explanations (pipeline serve, hourly; needs a loaded US Code). Each run explains up to
# min(AI_LAW_BATCH, AI_LAW_DAILY_CAP - bills attempted today in UTC) bills whose latest text amends,
# repeals or adds US Code sections, one Gemini call each, on the AI_* settings above.
# AI_LAW_BATCH=50
# AI_LAW_DAILY_CAP=500
# Vertex AI batch re-summarization (docs/design/198-corpus-resummarization.md; defaults shown).
# Unset AI_BATCH_BUCKET turns it off: pipeline-summarize-batch submit refuses and serve doesn't
# poll. Set, sync-summaries polls open batches, imports their results and releases failed ones.
# AI_BATCH_BUCKET=
# AI_BATCH_LOCATION=global
# How long an exported bill stays out of the synchronous queue, and a job may stay open (Go duration).
# AI_BATCH_HOLD=100h
# submit refuses to export fewer due bills than this.
# AI_BATCH_MIN_BILLS=1000

# API environment: development (default) or production. Production refuses to start with
# FIREBASE_AUTH_EMULATOR_HOST set, and turns the account routes off unless ACCOUNTS_ENABLED=true.
APP_ENV=development
# Account routes (/me, votes, favorites, scorecard). Default: on in development, off in production.
# ACCOUNTS_ENABLED=true

# Sign-in: ID tokens from Identity Platform, or locally from the Firebase Auth emulator in
# docker-compose.yml (wiki page "Local sign-in"). AUTH_PROJECT_ID is required while accounts are
# on. Never set FIREBASE_AUTH_EMULATOR_HOST in production: emulator tokens are unsigned.
FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
AUTH_PROJECT_ID=demo-justabill

# Firebase App Check on the vote and import routes (docs/design/89-aggregate-analytics.md):
# off (default), audit (check and record user_votes.app_check_ok, reject nothing) or enforce
# (401 without a valid X-Firebase-AppCheck token). There's no App Check emulator, so keep it off
# locally; audit and enforce fetch Google's App Check keys for AUTH_PROJECT_ID at start-up.
# APP_CHECK_MODE=off
# Per-account write limits; 0 turns one off. Most bills one account may vote on in any 24 hours,
# and the least number of days between two changes to the account's state or district.
# AGG_DAILY_VOTE_CAP=500
# AGG_DISTRICT_CHANGE_DAYS=30
# Serve the published aggregates (GET /bills/{id}/aggregates[/{scope_key}], GET
# /members/{id}/alignment). Off by default: the routes answer 404 while the job runs dark.
# AGGREGATES_PUBLIC=false
# The pipeline's hourly aggregate-votes job (docs/design/89-aggregate-analytics.md, "The rules, in
# one place"). Votes count once the account is AGG_MIN_ACCOUNT_AGE_HOURS old and, with
# AGG_REQUIRE_APP_CHECK, passed App Check (so nothing counts while APP_CHECK_MODE is off). A state
# or district cell needs AGG_MIN_CELL_VOTES votes to show, the national cell
# AGG_MIN_NATIONAL_VOTES; a shown cell republishes after AGG_REPUBLISH_MIN_CHANGES changed votes
# and AGG_REPUBLISH_MIN_MINUTES. Holds: a burst over AGG_BURST_FACTOR times the hourly mean and
# AGG_BURST_MIN_VOTES; over AGG_YOUNG_SHARE_MAX_PCT percent of new votes from accounts under
# AGG_YOUNG_ACCOUNT_DAYS; a Yea swing of AGG_SWING_POINTS or more.
# AGG_MIN_ACCOUNT_AGE_HOURS=48
# AGG_REQUIRE_APP_CHECK=true
# AGG_MIN_CELL_VOTES=50
# AGG_MIN_NATIONAL_VOTES=100
# AGG_REPUBLISH_MIN_CHANGES=10
# AGG_REPUBLISH_MIN_MINUTES=60
# AGG_BURST_FACTOR=5
# AGG_BURST_MIN_VOTES=50
# AGG_YOUNG_ACCOUNT_DAYS=7
# AGG_YOUNG_SHARE_MAX_PCT=40
# AGG_SWING_POINTS=15

# CORS: the origins browsers may call the API from, comma-separated (scheme://host[:port]). An
# entry may put one * in the first label of its host, e.g. https://justabill-*-<team>.vercel.app
# for Vercel previews; it matches letters, digits and hyphens only. "*" itself is refused.
# Unset means http://localhost:3000 in development; production refuses to start without it and
# accepts only https origins.
CORS_ORIGIN=http://localhost:3000

# Find-my-reps geocoder: where the API sends addresses. Dev and CI only, for the browser smoke
# tests' stub (docs/design/84-e2e-smoke-tests.md); production leaves it unset, which means the
# Census Bureau (https://geocoding.geo.census.gov/geocoder/geographies/onelineaddress).
# CENSUS_GEOCODER_URL=http://localhost:8089/geocoder

# vercel-drain (api/cmd/vercel-drain, design 53 Decision 6): the Vercel log drain's signature
# secret and the team webhook's secret, both required. It forwards to the OTLP endpoint in the
# standard OTEL_* variables and drops everything without one. Production keeps both in Secret Manager.
# VERCEL_DRAIN_SECRET=
# VERCEL_WEBHOOK_SECRET=

# Web
NEXT_PUBLIC_API_URL=http://localhost:8080
# The API URL for server renders only, read at run time; unset, they use NEXT_PUBLIC_API_URL.
# docker-compose.yml sets it to http://api:8080, since the web container's localhost isn't the API.
# Vercel leaves it unset.
# API_INTERNAL_URL=
# Web account screens (/login, /settings) and the navbar's account links. Default: on in
# `next dev`, off in production builds. Inlined at build time, so on Vercel a change needs a
# redeploy. Keep it equal to the API's ACCOUNTS_ENABLED; production sets both from #28's
# accounts_enabled.
# NEXT_PUBLIC_ACCOUNTS_ENABLED=true
# The sign-in buttons (#652): a comma-separated list of google.com, apple.com and microsoft.com,
# shown in that order. Unset, all three (the Auth emulator takes any). Production lists only the
# providers turned on in Identity Platform: google.com at launch. Inlined at build time; Vercel
# builds fail on an unknown ID, or an empty list with accounts on.
# NEXT_PUBLIC_AUTH_PROVIDERS=google.com

# OpenTelemetry (API, pipeline and the web server; wiki Dev-Observability). Unset, nothing is
# exported. Production sets these on Vercel and GKE to the Collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# OTEL_SDK_DISABLED=true
# Browser telemetry (#292): the browser posts traces and errors to the web app's own relay
# (/api/otel/v1/*), which forwards them with the variables above and drops them without an
# endpoint. Inlined at build time. The sampler ratio defaults to 0.1 on Vercel production, else 1.
# NEXT_PUBLIC_OTEL_DISABLED=true
# NEXT_PUBLIC_OTEL_TRACES_SAMPLER_ARG=0.1

# Web sign-in (Firebase JS SDK, #137): on when accounts are on and the first three are set. The
# emulator accepts any API key; production uses the restricted browser key, the production domain
# as authDomain (next.config.ts proxies /__/auth/* to <project>.firebaseapp.com) and no emulator
# host (Vercel builds fail with one).
NEXT_PUBLIC_FIREBASE_API_KEY=fake-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=localhost
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-justabill
NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=localhost:9099
# Web App Check (#122): sends X-Firebase-AppCheck on votes and vote imports, for the API's
# APP_CHECK_MODE. On when sign-in is on and both the Firebase web app's ID and a reCAPTCHA
# Enterprise site key are set; reCAPTCHA then loads for signed-in users only. There's no App Check
# emulator, so leave these unset with the Auth emulator. Against a real project (local runs, CI or
# Vercel previews), a debug token registered in the Firebase console stands in for reCAPTCHA
# ("true" makes the SDK generate one and log it). Production builds refuse a debug token.
# NEXT_PUBLIC_FIREBASE_APP_ID=
# NEXT_PUBLIC_RECAPTCHA_SITE_KEY=
# NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG_TOKEN=

# On-demand revalidation (#297): POST /api/revalidate exists only when this is set. A
# comma-separated list of bearer secrets, so two can be live during a rotation; the
# pipeline sends one of them. Unset locally and in previews (the route answers 404).
# REVALIDATE_SECRETS=

# Required, no default: the number of reverse proxies in front of the API. 0 uses
# the TCP peer address (local dev); 2 behind Google's external Application Load
# Balancer. Production refuses 0. X-Real-IP and True-Client-IP are never read.
TRUSTED_PROXY_HOPS=0

# Optional: how long the API keeps an idle keep-alive connection open, as a Go duration.
# Default 620s, which outlasts the 600 s keepalive of Google's external Application Load
# Balancer; keep it above the load balancer's value or clients see stray 502s.
# HTTP_IDLE_TIMEOUT=620s
# How long /readyz answers 503 after SIGTERM before the API shuts down, so the load balancer
# stops sending it requests first. Default 0s (local dev); about 15s on GKE, where the pod's
# terminationGracePeriodSeconds must cover it plus the 10 s shutdown.
# SHUTDOWN_DRAIN=15s

# The web server's own rate limit (#270). Server renders on Vercel share egress IPs with other
# people's sites, so the API counts calls that carry a matching X-Server-Key in one "web-server"
# bucket of WEB_SERVER_RATE_LIMIT a minute per pod (default 1200) instead of per IP. The key only
# raises that limit. API_SERVER_KEYS (API) takes up to two comma-separated keys, 32+ characters each
# (`openssl rand -base64 32`), so a key can be rotated; empty turns the feature off. API_SERVER_KEY
# (web, server-only: never NEXT_PUBLIC_) is the key the web server sends; unset, it sends none and is
# limited by IP. Production: Secret Manager → the API pod's env, and a Vercel Secret env var.
# API_SERVER_KEYS=
# WEB_SERVER_RATE_LIMIT=1200
# Bill searches (GET /bills with q) also pass a search limit of their own (#619): 20 a minute per IP,
# and for the web server one "web-server-search" bucket of WEB_SERVER_SEARCH_RATE_LIMIT a minute per
# pod (default 300), counted within WEB_SERVER_RATE_LIMIT too. Every uncached search costs Spanner two
# full-text searches and a count.
# WEB_SERVER_SEARCH_RATE_LIMIT=300
# API_SERVER_KEY=

# Private mode until go-public (docs/design/28-production.md): public (default) or private. Private
# serves /api/v1 only to requests with a valid X-Server-Key (API_SERVER_KEYS) or from a client IP in
# ACCESS_ALLOW_CIDRS (comma-separated CIDRs or addresses); everyone else gets a bare 404, and
# /healthz and /readyz always answer. A bad mode or CIDR stops the API at startup.
# ACCESS_MODE=public
# ACCESS_ALLOW_CIDRS=
